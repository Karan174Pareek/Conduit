# Conduit Environment Configuration Example
# Copy this file to .env and configure values. NEVER commit .env to source control!

# Public URLs (Local: *.localhost, Prod: *.yourdomain.com)
PUBLIC_DASHBOARD_URL=http://dashboard.localhost
PUBLIC_GATEWAY_URL=http://gateway.localhost
PUBLIC_SHOP_URL=http://shop.localhost
ALLOWED_ORIGINS=http://dashboard.localhost

# Gateway Security & Auth Secrets (Generated by scripts/gen-secrets.sh)
SESSION_SECRET=example-session-secret-at-least-32-chars-long
API_KEY_PEPPER=example-api-key-pepper-for-hmac-sha256-hashing
# Format: kid1:base64key,kid0:base64key (active key is first)
CREDENTIAL_ENC_KEYS=kid1:YOUR_BASE64_32BYTE_KEY_HERE

# Bootstrap Admin Credentials
BOOTSTRAP_ADMIN_EMAIL=admin@conduit.localhost
BOOTSTRAP_ADMIN_PASSWORD=example-admin-secure-password-1234

# LLM Integration (Requires a valid Google Gemini API key)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# woo-mcp Authentication
WOO_MCP_BEARER_TOKEN=example-woo-mcp-internal-bearer-token

# WooCommerce Store & Database (store-default namespace)
MARIADB_ROOT_PASSWORD=example-mariadb-root-password
MARIADB_PASSWORD=example-mariadb-user-password
WP_ADMIN_PASSWORD=example-wordpress-admin-password
WP_CONSUMER_KEY=ck_example_consumer_key_for_testing_only
WP_CONSUMER_SECRET=cs_example_consumer_secret_for_testing_only
