{
  "name": "conduit",
  "version": "0.1.0",
  "private": true,
  "description": "Team MCP Gateway + WooCommerce Hosting on Kubernetes",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspace=@conduit/shared --if-present build && npm run --workspaces --if-present build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node dev/run-tests.mjs",
    "test:vitest": "vitest run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "9.21.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "22.13.5",
    "eslint": "9.21.0",
    "playwright": "^1.64.0",
    "prettier": "3.9.10",
    "typescript": "5.7.3",
    "typescript-eslint": "8.25.0",
    "vitest": "3.0.7",
    "zod": "3.24.2"
  }
}
